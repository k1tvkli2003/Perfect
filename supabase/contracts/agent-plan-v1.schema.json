{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://perfect.local/contracts/agent-plan-v1.schema.json",
  "title": "Perfect Agent Plan",
  "description": "Create-only, owner-review-required planner proposals for Perfect.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "agent_device_id",
    "source",
    "plan",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "submission_id": {
      "$ref": "#/$defs/nonNilUuid"
    },
    "agent_device_id": {
      "$ref": "#/$defs/nonNilUuid"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "title"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/nonNilUuid"
          },
          "kind": {
            "enum": [
              "one_off_task",
              "recurring_task",
              "habit",
              "project"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "payload": {
            "type": "object",
            "maxProperties": 128,
            "not": {
              "required": [
                "agent_proposal"
              ]
            },
            "additionalProperties": true
          }
        }
      }
    }
  },
  "$defs": {
    "nonNilUuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    }
  }
}
