# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/.gradle/
/android/.kotlin/
/android/local.properties
/windows/flutter/ephemeral/

# Local Supabase connection values. The app receives public client settings
# through --dart-define; never commit a service-role or database secret.
.env
.env.*
!.env.example

# Legacy source and unselected Flutter targets are deliberately retained
# locally during the private-project migration, but are not part of Perfect.
/lib/src/
/lib/unused/
/screenshots/
/ios/
/linux/
/macos/
