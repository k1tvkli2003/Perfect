# Perfect! — local development environment template.
#
# Copy this file to `.env` and fill in the values for your private Supabase
# project. The `.env` file is git-ignored; never commit real credentials.
#
# Pass these to Flutter through --dart-define-from-file or individual flags:
#
#   flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_PUBLISHABLE_KEY=...
#
# Only the project URL and publishable (anon) key belong here. A service-role
# or secret key must never appear in this file, the repository, or CI logs.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_ANON_KEY
SUPABASE_AUTH_REDIRECT_URI=perfect://login-callback
