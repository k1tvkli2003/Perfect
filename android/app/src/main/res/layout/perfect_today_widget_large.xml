<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/perfect_widget_surface"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/perfect_widget_mark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <ImageView
                android:id="@+id/widget_open_today"
                android:layout_width="104dp"
                android:layout_height="26dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/widget_open_today_description"
                android:scaleType="fitStart"
                android:src="@drawable/perfect_widget_wordmark_raster" />

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/perfect_widget_muted"
                android:textDirection="locale"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_freshness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/perfect_widget_mint"
            android:textDirection="locale"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_quick_add"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/perfect_widget_quick_add"
            android:contentDescription="Quick add task"
            android:gravity="center"
            android:minWidth="96dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="+  Add task"
            android:textColor="@color/perfect_widget_ink"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_orbit_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/perfect_widget_muted"
        android:textDirection="locale"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/widget_task_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Your day is ready"
        android:textColor="@color/perfect_widget_muted"
        android:textDirection="locale"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_open_today_footer"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/perfect_widget_action"
        android:gravity="center"
        android:text="Open Today"
        android:textColor="@color/perfect_widget_ink"
        android:textDirection="locale"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
