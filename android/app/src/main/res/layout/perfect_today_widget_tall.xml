<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/perfect_widget_surface"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Perfect!"
            android:src="@drawable/perfect_widget_mark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <TextView
                android:id="@+id/widget_open_today"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Perfect!"
                android:textColor="@color/perfect_widget_ink"
                android:textDirection="locale"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/perfect_widget_muted"
                android:textDirection="locale"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_quick_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/perfect_widget_quick_add"
            android:contentDescription="Quick add task"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/perfect_widget_ink"
            android:textSize="24sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_freshness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/perfect_widget_mint"
        android:textDirection="locale"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_orbit_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/perfect_widget_muted"
        android:textDirection="locale"
        android:textSize="10sp" />

    <ListView
        android:id="@+id/widget_task_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:maxLines="3"
        android:text="Your day is ready"
        android:textColor="@color/perfect_widget_muted"
        android:textDirection="locale"
        android:textSize="11sp" />
</LinearLayout>
