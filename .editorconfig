# Perfect! editor configuration.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Dart source follows `dart format` conventions (two-space indent, 80-column
# soft limit, trailing commas in multi-line collections).
[*.dart]
indent_size = 2

# Kotlin on Android follows the standard four-space convention.
[*.{kt,kts}]
indent_size = 4

# SQL migrations use two-space indent to stay readable inside the CI diff.
[*.sql]
indent_size = 2

# Python tooling (brand-asset verification, wordmark generation, agent-plan
# submission) follows PEP 8 with four-space indent.
[*.py]
indent_size = 4

# Generated Drift bindings and other mechanical outputs are excluded from the
# trailing-whitespace rule so regeneration never introduces noise.
[*.g.dart]
trim_trailing_whitespace = false

# Markdown files keep trailing whitespace only where it is semantically
# meaningful (hard line breaks); trim only on pure blank lines.
[*.md]
trim_trailing_whitespace = false

# JSON schemas and manifests: two-space indent, UTF-8, trailing newline.
[*.json]
indent_size = 2

# TypeScript Edge Function follows the project's two-space Deno convention.
[*.ts]
indent_size = 2

# CMake: two-space indent as used by the Flutter Windows template.
[*.cmake]
indent_size = 2
[CMakeLists.txt]
indent_size = 2

# Shell and Bash scripts: two-space indent.
[*.{sh,bash}]
indent_size = 2

# PowerShell signing and provisioning scripts: two-space indent.
[*.{ps1,psm1}]
indent_size = 2
